{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "portfolio",
    "compatibility_date": "2024-12-04",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": ".vercel/output/static/_worker.js/index.js",
    "assets": {
        "binding": "ASSETS",
        "directory": ".vercel/output/static"
    }
}